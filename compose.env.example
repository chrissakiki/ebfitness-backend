# Copy to compose.env and fill in. compose.env is not committed.
# Start with: docker compose --env-file compose.env up -d --build

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=elie_badawi
MYSQL_USER=ebfitness
MYSQL_PASSWORD=change-me

# Must match the database you export. utf8 matches the current app.
DB_CHARSET=utf8

APP_URL=https://www.ebfitness.co
JWT_SECRET_KEY=change-me-long-random
COOKIE_EXPIRY_TIME=3600

# Caddy on the host proxies to this port. It is bound to 127.0.0.1 only.
PHP_PORT=8080
# Optional phpMyAdmin-style UI: docker compose --env-file compose.env --profile admin up -d
ADMINER_PORT=8081
